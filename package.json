{
  "name": "bettermakati",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:site && npm run check:content && npm run check:barangays && npm run check:civic-map && npm run check:brand && npm run audit:services && npm run audit:pages && tsc -b && vite build && node scripts/postbuild-routes.mjs && node scripts/check-built-metadata.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky",
    "convert-yaml": "node scripts/yaml-to-json.js",
    "dev:yaml": "npm run convert-yaml && npm run dev",
    "setup": "node scripts/setup-starter-kit.js",
    "index-content": "node scripts/index-content.mjs",
    "update:news": "node scripts/update-news-snapshot.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:city-monitor": "node scripts/check-city-monitor.mjs",
    "generate:site": "node scripts/generate-site-files.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:civic-map": "node scripts/check-civic-map.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "audit:services": "node scripts/audit-service-depth.mjs",
    "audit:pages": "node scripts/audit-page-freshness.mjs",
    "quality": "npm run lint && npm run check:content && npm run check:barangays && npm run check:civic-map && npm run check:brand && npm run audit:services && npm run audit:pages",
    "check:barangays": "node scripts/check-barangays.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bettergov/kapwa": "^1.2.4",
    "@tailwindcss/typography": "^0.5.18",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^4.0.1",
    "js-yaml": "^5.2.2",
    "lucide-react": "^0.575.0",
    "meilisearch": "^0.60.0",
    "nuqs": "^2.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
